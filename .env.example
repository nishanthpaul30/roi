# Database connection string (SQLite for local zero-config, PostgreSQL for production)
# PostgreSQL example: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/copilot_metrics?schema=public"
DATABASE_URL="file:./dev.db"

# GitHub Enterprise / Org Copilot API Access Token (Never exposed to browser)
# Requires 'manage_billing:copilot', 'read:enterprise', or 'read:org' scope
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"
GITHUB_ENTERPRISE_SLUG="acme-corp"
GITHUB_ORG_SLUG="acme-engineering"

# Default Dashboard Settings
NEXT_PUBLIC_APP_NAME="GitHub Copilot Usage & ROI Dashboard"
